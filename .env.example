# Copy to .env and edit. Never commit .env (it is in .gitignore).
MQTT_HOST=mosquitto          # "mosquitto" inside docker compose, the broker's LAN IP otherwise
MQTT_PORT=1883               # 8883 with MQTT_CA set (TLS, as esp32-mqtt-sensor-node uses)
MQTT_USER=collector
MQTT_PASSWORD=change-me
MQTT_CA=                     # path to the broker CA certificate; empty = plain TCP
MQTT_PREFIX=farm             # topics: <prefix>/<node>/telemetry and <prefix>/<node>/status
DB_PATH=data/telemetry.db
RAW_DAYS=30                  # raw readings older than this are rolled up to hourly and deleted
HOURLY_DAYS=730              # hourly aggregates older than this are deleted
COMPACT_EVERY_S=3600         # how often the collector runs the roll-up + checkpoint
API_HOST=0.0.0.0
API_PORT=8000
